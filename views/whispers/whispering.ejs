<!DOCTYPE html>
<html lang="en">
  <%- include("../includes/head.ejs") %>
  <body>
    <%- include("../includes/header.ejs") %>
    <main
      class="flex flex-col gap-10 items-center justify-center max-w-[1440px] mx-auto py-10 px-10"
    >
      <section>
        <h1 class="text-4xl font-bold mb-10 text-center">Whispering</h1>
      </section>
      <section>
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr>
              <th class="px-6 py-3 bg-gray-50 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider">Message</th>
              <th class="px-6 py-3 bg-gray-50 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider">User</th>
              <th class="px-6 py-3 bg-gray-50 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider">Created At</th>
              <th class="px-6 py-3 bg-gray-50 text-left text-xs leading-4 font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% whispers.forEach((whisper) => { %>
              <tr>
                <td class="px-6 py-4 whitespace-no-wrap"><%= whisper.message %></td>
                <td class="px-6 py-4 whitespace-no-wrap"><%= whisper.userName %></td>
                <td class="px-6 py-4 whitespace-no-wrap"><%= new Date(whisper.createdAt).toLocaleString() %></td>
                <td class="px-6 py-4 whitespace-no-wrap flex gap-2">
                  <form action="whispers/edit/<%- whisper.id %>" method="GET">
                    <button type="submit" class="bg-violet-900 hover:bg-violet-700 text-white font-bold py-2 px-4 rounded">Edit</button>
                  </form>
                  <form action="whispers/delete/<%- whisper.id %>" method="POST">
                    <button type="submit" class="bg-violet-900 hover:bg-violet-700 text-white font-bold py-2 px-4 rounded">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
